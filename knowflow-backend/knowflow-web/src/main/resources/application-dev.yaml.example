# ============================================================================
# 开发环境配置模板
# 使用方法：复制本文件为 application-dev.yaml 并按需填写后使用。
# 注意：application-dev.yaml 已被 .gitignore 忽略，不会提交到仓库；
#      本模板（.example）不包含任何真实密钥/密码。
# ============================================================================

spring:
  # 数据源配置（本地 PostgreSQL）
  datasource:
    url: jdbc:postgresql://localhost:5432/knowflow
    username: admin
    password: ${POSTGRES_PASSWORD:123456}   # 本地开发库密码，建议用环境变量注入
    driver-class-name: org.postgresql.Driver

  # Redis 配置（对话上下文缓存）
  data:
    redis:
      host: localhost
      port: 6379
      database: 0

  # Spring AI：OpenAI 兼容接口（Chat 对话）
  # 本地模式：base-url 指向本地 llama.cpp；云端模式：base-url 指向 DeepSeek/OpenAI
  ai:
    openai:
      # 本地 llama.cpp 填 llama；云端 DeepSeek 填 ${DEEPSEEK_API_KEY}（禁止硬编码）
      api-key: llama
      base-url: http://localhost:8081        # 本地: http://localhost:8081 ；云端: https://api.deepseek.com
      chat:
        # 本地: Qwen2.5-7B-Q4KM ；云端: deepseek-v4-flash / deepseek-v4-pro
        model: Qwen2.5-7B-Q4KM
        temperature: 0.7
        # 云端 DeepSeek 若想省钱，可关闭思考模式（默认开启会放大 token 消耗）：
        # options:
        #   thinking:
        #     type: disabled

    # pgvector 向量存储（RAG 知识库检索，维度需与 Embedding 模型一致）
    vectorstore:
      pgvector:
        dimensions: 512
        index-type: HNSW
        distance-type: COSINE_DISTANCE
        schema-validation: true

# 本地 Embedding 模型（ONNX 本地推理，无需外部 API）
# 使用 bge-small-zh-v1.5（中文优化，512 维），模型文件在 knowflow-web/src/main/resources/models/bge-small-zh-v1.5/ 下
knowflow:
  embedding:
    model-uri: classpath:models/bge-small-zh-v1.5/model.onnx
    tokenizer-uri: classpath:models/bge-small-zh-v1.5/tokenizer.json
    cache-dir: ./data/embedding-cache

server:
  port: 8080
  servlet:
    context-path: /api

# JWT 配置（生产环境务必通过环境变量注入，勿使用默认值）
jwt:
  secret: ${JWT_SECRET:KnowFlow-Dev-Only-Secret-Change-Me}
  expiration-ms: 604800000  # 7 天（单位：毫秒）

# MyBatis-Plus 配置
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
